# PostgreSQL Configuration
POSTGRES_USER=gymos
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=gymos
POSTGRES_PORT=5433

# Application Backend
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://gymos:replace_with_secure_password@localhost:5433/gymos?schema=public

# Current user (single-user MVP); the seed provisions this address
GYMOS_USER_EMAIL=demo@gymos.app

# Web push (optional). Generate a key pair with: bunx web-push generate-vapid-keys
# Both keys are required to enable push; without them the in-app rest timer is used.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

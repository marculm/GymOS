datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workoutSessions WorkoutSession[]
  nutritionLogs   NutritionLog[]
  recipes         Recipe[]
  plans           WorkoutPlan[]
  rotationItems   WorkoutRotationItem[]

  @@map("users")
}

model Exercise {
  id             String       @id @default(uuid())
  name           String       @unique
  muscleGroup    String
  description    String?
  defaultSets    Int          @default(3)
  defaultReps    Int          @default(8)
  defaultWeightKg Float?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  sets           WorkoutSet[]
  planExercises  WorkoutPlanExercise[]

  @@index([deletedAt])
  @@map("exercises")
}

model WorkoutSession {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  planId      String?
  plan        WorkoutPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  sets        WorkoutSet[]
  createdAt   DateTime     @default(now())

  @@index([userId, completedAt])
  @@map("workout_sessions")
}

model WorkoutSet {
  id               String         @id @default(uuid())
  workoutSessionId String
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exerciseId       String
  exercise         Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  setNumber        Int
  reps             Int
  weightKg         Float
  createdAt        DateTime       @default(now())

  @@unique([workoutSessionId, exerciseId, setNumber])
  @@map("workout_sets")
}

model Recipe {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  title        String
  sourceUrl    String?
  servings     Int      @default(1)
  calories     Float
  proteinGrams Float
  carbsGrams   Float
  fatGrams     Float
  ingredients  Json
  instructions Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("recipes")
}

model NutritionLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loggedAt     DateTime @default(now())
  name         String
  calories     Float
  proteinGrams Float
  carbsGrams   Float
  fatGrams     Float
  createdAt    DateTime @default(now())

  @@map("nutrition_logs")
}

model WorkoutPlan {
  id          String                @id @default(uuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  exercises     WorkoutPlanExercise[]
  sessions      WorkoutSession[]
  rotationItems WorkoutRotationItem[]

  @@unique([userId, name])
  @@map("workout_plans")
}

model WorkoutPlanExercise {
  id         String      @id @default(uuid())
  planId     String
  plan       WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  position   Int
  notes      String?

  @@unique([planId, position])
  @@map("workout_plan_exercises")
}

model WorkoutRotationItem {
  id       String      @id @default(uuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId   String
  plan     WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  position Int

  @@unique([userId, position])
  @@unique([userId, planId])
  @@index([planId])
  @@map("workout_rotation_items")
}

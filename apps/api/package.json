{
  "name": "@gymos/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --env-file=../../.env --watch src/index.mts",
    "start": "bun src/index.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "bun check",
    "db:generate": "bunx prisma generate",
    "db:migrate": "bunx prisma migrate dev",
    "db:migrate:deploy": "bunx prisma migrate deploy",
    "db:seed": "bun prisma/seed.mts",
    "db:setup": "bun run db:migrate:deploy && bun run db:seed",
    "db:studio": "bunx prisma studio"
  },
  "dependencies": {
    "@gymos/shared": "workspace:*",
    "@prisma/client": "^6.4.0",
    "hono": "^4.7.2",
    "pino": "^9.6.0",
    "prisma": "^6.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "vitest": "^4.1.11"
  }
}

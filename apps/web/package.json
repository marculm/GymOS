{
  "name": "@gymos/web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun scripts/check-build.mts",
    "preview": "vite preview",
    "test": "svelte-kit sync && vitest run",
    "test:watch": "svelte-kit sync && vitest --watch",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "prepare": "svelte-kit sync"
  },
  "dependencies": {
    "@gymos/shared": "workspace:*",
    "lucide-svelte": "^1.0.1",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.4.2",
    "happy-dom": "^21.0.4",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.0",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}

{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "sourceMap": true,
    "strict": true,
    "types": [
      "$app/types",
      "vite/client",
      "vite-plugin-pwa/client"
    ]
  },
  "include": [
    "src/**/*",
    "vite.config.ts"
  ]
}

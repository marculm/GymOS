{
  "name": "gymos",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @gymos/api dev & bun --filter @gymos/web dev",
    "dev:api": "bun --filter @gymos/api dev",
    "dev:web": "bun --filter @gymos/web dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "bun check",
    "lint": "bunx oxlint",
    "lint:adr": "bun run tools/check-architecture.ts",
    "lint:all": "bun run lint && bun run lint:adr"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}

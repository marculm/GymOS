{
  "name": "gymos",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @gymos/api dev & bun --filter @gymos/web dev",
    "build": "bun --filter @gymos/web build",
    "dev:api": "bun --filter @gymos/api dev",
    "dev:web": "bun --filter @gymos/web dev",
    "dev:all": "bun run db:migrate && bun run db:seed && bun run dev",
    "test": "bun --filter @gymos/api db:generate && bun x vitest run",
    "test:watch": "bun x vitest",
    "typecheck": "bun --filter @gymos/api db:generate && bun --filter @gymos/api typecheck && bun --filter @gymos/shared typecheck && bun --filter @gymos/web typecheck",
    "lint": "bunx oxlint",
    "lint:adr": "bun run tools/check-architecture.ts",
    "lint:all": "bun run lint && bun run lint:adr",
    "db:up": "docker compose --env-file .env -f deploy/docker/docker-compose.yml up -d",
    "db:down": "docker compose --env-file .env -f deploy/docker/docker-compose.yml down",
    "db:migrate": "bun --env-file=.env --filter @gymos/api db:migrate",
    "db:seed": "bun --env-file=.env --filter @gymos/api db:seed",
    "db:studio": "bun --env-file=.env --filter @gymos/api db:studio"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxlint": "^1.89.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
